# Cấu hình Firebase Project (Lấy tại Firebase Console -> Project Settings -> General -> Your apps)
# Sao chép file này thành .env và điền thông tin thật của bạn (hoặc nhập trực tiếp trên giao diện ứng dụng)

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mma301-fxxx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mma301-fxxx
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=mma301-fxxx.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456...:web:abcdef...

# Tuỳ chọn: VAPID Key dùng cho Web Push Notification (Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates)
EXPO_PUBLIC_FIREBASE_VAPID_KEY=BEl62iUYgUivxIkv69yViEu...